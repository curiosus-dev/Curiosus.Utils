        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\..\..\src\Hosting\Curiosus.Hosting\Curiosus.Hosting.csproj" />
      <ProjectReference Include="..\..\..\..\src\Messaging\Curiosus.RabbitMQ\Curiosus.RabbitMQ.csproj" />
      <ProjectReference Include="..\Curiosus.RequestProcessing.RabbitMQ.Sample.Common\Curiosus.RequestProcessing.RabbitMQ.Sample.Common.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="RabbitMQ.Client" />
    </ItemGroup>

    <ItemGroup>
      <None Update="config.yml">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Include="..\..\..\NLog.config">
        <Link>NLog.config</Link>
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
    </ItemGroup>

</Project>
