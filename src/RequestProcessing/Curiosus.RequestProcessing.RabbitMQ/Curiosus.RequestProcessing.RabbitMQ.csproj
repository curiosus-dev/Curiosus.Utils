<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>$(CuriosusTargetFrameworks)</TargetFrameworks>

        <PackageId>Curiosus.RequestProcessing.RabbitMQ</PackageId>
        <Title>Curiosus.RequestProcessing.RabbitMQ</Title>
        <Description>Services to receive and process reqesuts/events from RabbitMQ.</Description>
        <Summary>Services to receive and process requests/events from RabbitMQ.</Summary>
        <PackageTags>Curiosus; Request; Queue; Workers; Processors; RabbitMQ; RPC; AMQP; Messaging</PackageTags>
        <Language>English</Language>

        <AssemblyVersion>1.0.0</AssemblyVersion>
        <FileVersion>1.0.0</FileVersion>

        <Authors>$(CuriosusAuthors), Andrei Vinogradov (@anri-vin)</Authors>

        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>

        <PackageProjectUrl>https://github.com/curiosus-dev/Curiosus.Utils</PackageProjectUrl>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/curiosus-dev/Curiosus.Utils</RepositoryUrl>

        <OutputType>Library</OutputType>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>
    </PropertyGroup>
    <ItemGroup>
      <ProjectReference Include="..\..\Messaging\Curiosus.RabbitMQ\Curiosus.RabbitMQ.csproj" />
      <ProjectReference Include="..\Curiosus.RequestProcessing\Curiosus.RequestProcessing.csproj" />
    </ItemGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <DocumentationFile>bin\Release\Curiosus.RequestProcessing.RabbitMQ.xml</DocumentationFile>
    </PropertyGroup>

</Project>
