<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(CuriosusTargetFrameworks)</TargetFrameworks>

        <PackageId>Curiosus.Configuration.YML</PackageId>
        <Title>Curiosus.Configuration.YML</Title>
        <Description>YAML configuration provider.</Description>
        <Summary>YAML configuration provider.</Summary>
        <PackageTags>Curiosus; configuration; yaml; yml; siisltd</PackageTags>
        <Language>English</Language>

        <RootNamespace>Curiosus.Configuration</RootNamespace>

        <AssemblyVersion>1.0.0</AssemblyVersion>
        <FileVersion>1.0.0</FileVersion>
        <PackageVersion>2.0.0</PackageVersion>

        <Authors>Max Markelow (@markeli), Andrei Vinogradov (@anri-vin)</Authors>
        <Copyright>SIIS Ltd, 2026</Copyright>

        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>

        <PackageProjectUrl>https://github.com/curiosus-dev/Curiosus.Utils</PackageProjectUrl>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/curiosus-dev/Curiosus.Utils</RepositoryUrl>
        <PackageReleaseNotes>https://github.com/curiosus-dev/Curiosus.Utils/tree/master/src/Configuration/Curiosus.Configuration.YML/CHANGELOG.md</PackageReleaseNotes>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>
    </PropertyGroup>

    <PropertyGroup>
        <PackageIcon>siisltd.png</PackageIcon>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\..\siisltd.png" Pack="true" PackagePath="\" />
    </ItemGroup>
    
    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <DocumentationFile>bin\Release\Curiosus.Configuration.YAML.xml</DocumentationFile>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
      <PackageReference Include="NetEscapades.Configuration.Yaml" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Curiosus.Configuration\Curiosus.Configuration.csproj" />
    </ItemGroup>

</Project>
