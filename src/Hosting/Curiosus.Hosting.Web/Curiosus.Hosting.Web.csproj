<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFrameworks>$(CuriosusTargetFrameworks)</TargetFrameworks>
        
        <PackageId>Curiosus.Hosting.Web</PackageId>
        <Title>Curiosus.Hosting.Web</Title>
        <Description>Hosting tools for Web applications.</Description>
        <Summary>Hosting tools for Web applications.</Summary>
        <PackageTags>Curiosus; Hosting; Boostrapping; Web; WebAPI</PackageTags>
        <Language>English</Language>

        <AssemblyVersion>1.0.0</AssemblyVersion>
        <FileVersion>1.0.0</FileVersion>

        <Authors>$(CuriosusAuthors), Andrey Ioch (@DevCorvette), Andrei Vinogradov (@anri-vin)</Authors>

        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>

        <PackageProjectUrl>https://github.com/curiosus-dev/Curiosus.Utils</PackageProjectUrl>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/curiosus-dev/Curiosus.Utils</RepositoryUrl>
        <PackageReleaseNotes>https://github.com/curiosus-dev/Curiosus.Utils/tree/master/src/Hosting/Curiosus.Hosting.Web/CHANGELOG.md</PackageReleaseNotes>
      
        <OutputType>Library</OutputType>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <DocumentationFile>bin\Release\Curiosus.Hosting.Web.xml</DocumentationFile>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\Misc\Curiosus.Tools.Web\Curiosus.Tools.Web.csproj" />
      <ProjectReference Include="..\Curiosus.Hosting\Curiosus.Hosting.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="MailKit" />
      <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" />
      <PackageReference Include="NLog.MailKit" />
      <PackageReference Include="NLog.Web.AspNetCore" />
      <PackageReference Include="System.ComponentModel.Annotations" />
    </ItemGroup>

</Project>
