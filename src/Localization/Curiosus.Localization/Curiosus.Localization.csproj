<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(CuriosusTargetFrameworks)</TargetFrameworks>

    <PackageId>Curiosus.Localization</PackageId>
    <Title>Curiosus.Localization</Title>
    <Description>Classes for localizing applications in more efficient way than Microsfot's way.</Description>
    <Summary>Classes for localizing applications in more efficient way than Microsfot's way.</Summary>
    <PackageTags>Curiosus; Localization</PackageTags>
    <Language>English</Language>

    <AssemblyVersion>1.0.0</AssemblyVersion>
    <FileVersion>1.0.0</FileVersion> 

    <Authors>$(CuriosusAuthors), Andrei Vinogradov (@anri-vin), Adil Mir (@AdilMirSz)</Authors>

    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <PackageProjectUrl>https://github.com/curiosus-dev/Curiosus.Utils</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/curiosus-dev/Curiosus.Utils</RepositoryUrl>

    <OutputType>Library</OutputType>
        <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Localization.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Misc\Curiosus.Tools\Curiosus.Tools.csproj" />
  </ItemGroup>

</Project>
